# Local dev: copy to `.env.local` and align with `apps/web` (same Supabase project).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# When the SPA runs on a different origin than Next (e.g. Vite :5173), deep links to legacy-only UI:
# VITE_WEB_ORIGIN=http://localhost:3000

# Optional client error reporting (staging/production recommended):
# VITE_SENTRY_DSN=
# Optional Sentry environment label (defaults to Vite MODE if unset):
# VITE_SENTRY_ENVIRONMENT=staging
