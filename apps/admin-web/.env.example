# ═══════════════════════════════════════════════════════════════
# Admin SPA (Vite) – public env
# Copy to `.env.local`. Prefer mirroring `apps/web/.env.example`.
#
# Resolution order (see vite.config.ts):
#   1) `apps/admin-web/.env*` keys below (VITE_*)
#   2) `apps/web/.env*` same semantic keys as Next (NEXT_PUBLIC_*)
#   3) process.env (e.g. Vercel injects NEXT_PUBLIC_* for the web project)
#
# You do NOT need to duplicate values if `apps/web/.env.local` is present when
# running Vite from this package — web env is merged automatically.
# ═══════════════════════════════════════════════════════════════

# ─── Supabase (browser client) — same project as Next ─────────
# Next equivalent: NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── App / canonical URLs — same as NEXT_PUBLIC_APP_URL / SITE_URL ──
VITE_APP_URL=http://localhost:3000
# VITE_SITE_URL=

# ─── Sentry (optional) — mirrors NEXT_PUBLIC_SENTRY_DSN ───────────
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=staging

# ─── Analytics / maps (optional) — mirror Next public keys ────────
# VITE_GOOGLE_ANALYTICS_ID=
# VITE_AMPLITUDE_API_KEY=
# VITE_MAPBOX_ACCESS_TOKEN=

# ─── Market / global entry (optional) — mirror Next public keys ─────
# VITE_GLOBAL_ENTRY_HOST=beautonomi.com
# VITE_DEFAULT_MARKET_HOST=beautonomi.co.za
# VITE_MARKET_OVERRIDE_TTL_HOURS=24

# ─── Asset cache bust (optional) ───────────────────────────────────
# VITE_CATEGORY_ICON_CACHE_REVISION=
