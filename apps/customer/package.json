{
  "name": "customer",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "postinstall": "cd ../.. && pnpm run build:packages",
    "dev": "node ../../tooling/expo-dev/port-safe-expo-dev.js 8081 8083",
    "start": "node ../../tooling/expo-dev/port-safe-expo-dev.js 8081 8083",
    "clean:web": "node -e \"const fs=require('fs'); try{fs.rmSync('.expo',{recursive:true,force:true})}catch(e){}; try{fs.rmSync('node_modules/.cache',{recursive:true,force:true})}catch(e){}\"",
    "start:clear": "node ../../tooling/expo-dev/port-safe-expo-dev.js 8081 8083 clear",
    "dev:lan": "expo start --go --lan",
    "dev:tunnel": "expo start --go --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "env:init": "node ../../tooling/expo-dev/init-env-local.js .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "expo lint",
    "clean": "npx rimraf node_modules"
  },
