# ═══════════════════════════════════════════════════════════════
# Beautonomi Provider App – Environment Variables
# Copy to .env.local and fill in your values. NEVER commit .env.local.
# Run: pnpm env:init (auto-creates .env.local from this template)
# ═══════════════════════════════════════════════════════════════

# ─── Supabase (REQUIRED) ─────────────────────────────────────
# Get from: https://supabase.com/dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ─── Backend API URL (REQUIRED) ─────────────────────────────
# Must point to the running web app (apps/web).
# Local dev: http://localhost:3000 or http://<your-ip>:3000
# Use the default apps/web dev server (pnpm dev uses Webpack) so dynamic API routes like /api/.../[id] work.
# Production: https://yourdomain.com
# Also used to load global category icons (DB paths like /images/...) in onboarding and settings.
EXPO_PUBLIC_APP_URL=

# ─── Tenant Host Hint (recommended for global-ready single build) ─────────
# Hostname used as default x-forwarded-host for tenant resolution.
# Can be overridden at runtime by deep links / market switcher.
EXPO_PUBLIC_WEB_API_TENANT_HOST=beautonomi.co.za
# Global-entry control for runtime market popup behavior:
EXPO_PUBLIC_GLOBAL_ENTRY_HOST=beautonomi.com
EXPO_PUBLIC_DEFAULT_MARKET_HOST=beautonomi.co.za
# Explicit market list shown in native selector (Format: host|Label,host|Label):
EXPO_PUBLIC_MARKET_HOST_OPTIONS=beautonomi.co.za|South Africa
# Manual override cooldown before auto-switch resumes (hours).
EXPO_PUBLIC_MARKET_OVERRIDE_TTL_HOURS=24
# ISO 4217 code used before /api/public/config-bundle loads (offline splash). Must match this build’s primary market. Default ZAR if unset/invalid.
# EXPO_PUBLIC_DEFAULT_REGION_CURRENCY=ZAR

# ─── Default Phone Region (recommended) ─────────────────────
# Force South Africa (+27) as the phone country picker default regardless of device locale.
# Without this, devices with US/other locale will default to their region's calling code.
EXPO_PUBLIC_DEFAULT_PHONE_REGION=ZA

# ─── OneSignal Push Notifications (optional) ────────────────
# Get from: https://app.onesignal.com → Settings → Keys & IDs
# Omit to disable push notifications.
# EXPO_PUBLIC_ONESIGNAL_APP_ID=

# ─── Amplitude Analytics (optional) ─────────────────────────
# Fetched from backend by default. Override here if needed.
# EXPO_PUBLIC_AMPLITUDE_API_KEY=

# ─── Sentry (optional) – project: mobile-provider ───────────
# Get from: https://sentry.io → Project Settings → Client Keys (DSN)
# EXPO_PUBLIC_SENTRY_DSN=

# ─── iOS App Store ID (optional) ───────────────────────────
# Numeric ID from App Store Connect. EAS production profile sets this; override for local builds if needed.
# EXPO_PUBLIC_IOS_APP_STORE_ID=

# ─── Screenshot automation (local capture builds ONLY) ─────
# Never enable in production EAS env. Enables provider://screenshot/* deep links and reduces capture noise.
# EXPO_PUBLIC_SCREENSHOT_MODE=1
# Optional: booking detail deep link (customer app uses same key if you share env files)
# EXPO_PUBLIC_SCREENSHOT_BOOKING_ID=
