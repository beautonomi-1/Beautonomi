{
  "name": "provider",
  "version": "1.0.42",
  "main": "index.ts",
  "scripts": {
    "dev": "node ../../tooling/expo-dev/port-safe-expo-dev.js 8082 8084",
    "start": "cross-env CI=1 expo start --port 8082 --go --non-interactive --lan --web",
    "start:clear": "cross-env CI=1 expo start -c --port 8082 --go --non-interactive --lan --web",
    "dev:lan": "expo start --go --lan",
    "dev:tunnel": "expo start --go --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "env:init": "node ../../tooling/expo-dev/init-env-local.js .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "expo lint",
    "screenshots:android:public": "node ../../tooling/screenshots/scripts/capture.mjs provider public",
    "screenshots:android:auth": "node ../../tooling/screenshots/scripts/capture.mjs provider auth",
    "clean": "npx rimraf node_modules",
    "ios:credentials-help": "node -e \"console.log('\\nRun: eas credentials --platform ios\\n(Choose production, then complete Build Credentials for both targets.)\\nSee IOS_CREDENTIALS_SETUP.md for full steps.\\n')\"",
    "eas-build-post-install": "node ../../tooling/eas-prefetch-gradle.mjs"
  },
