{
  "name": "web",
  "version": "0.1.13",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next dev --webpack -p 3000",
    "dev:turbo": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next dev --turbopack -p 3000",
    "dev:webpack": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next dev --webpack -p 3000",
    "build": "node scripts/next-build.mjs",
    "build:webpack": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next build --webpack",
    "build:turbo": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next build --turbopack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:fix-all": "node scripts/lint-fix-all.mjs",
    "lint:fix-everything": "node scripts/lint-fix-everything.mjs",
    "lint:unused-report": "node scripts/lint-unused-report.mjs",
    "test": "vitest run --exclude \"**/account-status/**/__tests__/**\" && vitest run src/app/api/me/account-status/__tests__/route.test.ts",
    "test:account-status": "vitest run src/app/api/me/account-status/__tests__/route.test.ts",
    "test:run": "vitest run --exclude \"**/account-status/**/__tests__/**\" && vitest run src/app/api/me/account-status/__tests__/route.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:all": "node scripts/test-runner.js",
    "test:agent": "node scripts/test-agent.js",
    "test:health": "node scripts/health-check.js",
    "test:errors": "node scripts/test-runner.js --verbose",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "analyze": "ANALYZE=true next build",
    "check-bundle": "node scripts/check-bundle-size.mjs",
    "check-bundle:update": "node scripts/check-bundle-size.mjs --update",
    "normalize:category-pngs": "node scripts/normalize-wide-category-pngs.mjs",
    "codemod:last-resort-currency": "node ../../tooling/scripts/codemod-last-resort-currency.mjs && node ../../tooling/scripts/repair-last-resort-imports.mjs"
  },
