{
  "build": {
    "env": {
      "NODE_OPTIONS": "--max-old-space-size=6144",
      "TURBO_CONCURRENCY": "1",
      "TURBO_DAEMON": "false",
      "NEXT_TELEMETRY_DISABLED": "1",
      "CI": "true"
    }
  },
  "regions": ["cpt1"],
  "crons": [
    { "path": "/api/cron/send-reminders", "schedule": "0 * * * *" },
    { "path": "/api/cron/expire-booking-holds", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/expire-on-demand-requests", "schedule": "0 2 * * *" },
    { "path": "/api/cron/expire-custom-requests", "schedule": "15 2 * * *" },
    { "path": "/api/cron/execute-automations", "schedule": "0 6 * * *" },
    { "path": "/api/cron/process-recurring-bookings", "schedule": "0 0 * * *" },
    { "path": "/api/cron/check-low-stock", "schedule": "0 8 * * *" },
    { "path": "/api/cron/ranking-recompute", "schedule": "0 4 * * *" },
    { "path": "/api/cron/inactivity-retention", "schedule": "0 10 * * *" },
    { "path": "/api/cron/expire-message-attachments", "schedule": "30 3 * * *" },
    { "path": "/api/cron/expire-ads-campaigns", "schedule": "0 */2 * * *" },
    { "path": "/api/cron/expire-cancelled-subscriptions", "schedule": "0 2 * * *" },
    { "path": "/api/cron/subscription-reminders", "schedule": "0 7 * * *" },
    { "path": "/api/cron/provider-stall-check", "schedule": "0 */4 * * *" },
    { "path": "/api/cron/purge-audit-logs", "schedule": "0 2 * * 0" },
    { "path": "/api/cron/prune-webhook-events", "schedule": "30 2 * * *" },
    { "path": "/api/cron/abandoned-carts", "schedule": "0 */6 * * *" },
    { "path": "/api/cron/refresh-provider-analytics", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/refresh-reports", "schedule": "15 * * * *" },
    { "path": "/api/cron/process-whatsapp-queue", "schedule": "*/2 * * * *" },
    { "path": "/api/cron/reset-whatsapp-counters", "schedule": "0 * * * *" },
    { "path": "/api/cron/abandoned-bookings", "schedule": "0 * * * *" },
    { "path": "/api/cron/process-notification-queue", "schedule": "*/2 * * * *" },
    { "path": "/api/cron/prune-idempotency-keys", "schedule": "0 3 * * *" },
    { "path": "/api/cron/reconciliation-gate", "schedule": "0 5 * * *" },
    { "path": "/api/cron/slack-operational-alerts", "schedule": "15 * * * *" }
  ],
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" }
      ]
    },
    {
      "source": "/api/public/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=30, stale-while-revalidate=300" }
      ]
    }
  ]
}
