# Copy values into Vercel → Project → Settings → Environment Variables → Preview
# Supabase: beautonomi-staging (byfzhyqvtbasxptxdupf)

NEXT_PUBLIC_SUPABASE_URL=https://byfzhyqvtbasxptxdupf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=https://staging.beautonomi.com
# Must match tenant_domains.environment for staging hosts (migration 970 uses preview).
TENANT_DOMAIN_ENV=preview
# Vercel Preview sets VERCEL_ENV=preview; TENANT_DOMAIN_ENV is explicit override (recommended).
STRICT_TENANT_HOST_RESOLUTION=true
# Prefer staging.beautonomi.com rows only — do not fall back to production host map on preview.
TENANT_DOMAIN_FALLBACK_TO_PRODUCTION=false

CRON_SECRET=
CSRF_SECRET=

# Paystack test keys for Preview
# PAYSTACK_SECRET_KEY=
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
