# ═══════════════════════════════════════════════════════════════
# Beautonomi Web App – Environment Variables
# Copy to .env.local and fill in your values. NEVER commit .env.local.
# ═══════════════════════════════════════════════════════════════

# ─── Supabase (REQUIRED) ─────────────────────────────────────
# Get from: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required in production for sitemap provider URLs filtered by tenant (Host → tenant_domains via resolveTenantIdWithZaFallback). If unset, sitemap still builds but lists all indexable providers (legacy dev behaviour).
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket for POST /api/upload (product images). Default: product-images. Apply migration 405_storage_product_images_bucket.sql in Supabase.
# STORAGE_PRODUCT_BUCKET=product-images
# Optional: override Storage bucket id for chat + support ticket uploads (default: message-attachments)
# MESSAGE_ATTACHMENTS_BUCKET=message-attachments

# Local multi-tenant: when the browser/API Host is localhost or 127.0.0.1 and NODE_ENV is not production,
# use this tenant slug for public routes (e.g. /api/public/home) instead of tenant_domains → za.
# Set to the slug that owns your dev providers if lists are empty (see tenants.slug in Supabase).
# DEV_DEFAULT_TENANT_SLUG=za
# For global-ready production, set to true so unknown hosts fail closed (no implicit za fallback).
STRICT_TENANT_HOST_RESOLUTION=true
# Optional: override which tenant_domains.environment row to match (production | preview | development | staging).
# Defaults from VERCEL_ENV / NODE_ENV when unset.
# TENANT_DOMAIN_ENV=preview
# When resolving on preview/dev, allow falling back to production host mappings if no preview row exists (default true).
# TENANT_DOMAIN_FALLBACK_TO_PRODUCTION=true
# Emit JSON lines with metric tenant_resolution_fallback (za fallback or env→production fallback). Set false to silence.
# LOG_TENANT_RESOLUTION_FALLBACK=true
# Production admin isolation: comma-separated hostnames that should serve the admin surface only.
# Keep unset locally unless you are testing Host-based routing. Set in Vercel production:
# ADMIN_HOST=admin.beautonomi.com
# Emergency rollback without removing the domain:
# ENABLE_ADMIN_HOST_ROUTING=false
# Comma-separated launched markets by ISO2 country (used for availability popup/policy), e.g. ZA,UK,US
SUPPORTED_MARKET_COUNTRIES=ZA
# Optional deny list by ISO2 for legal/compliance restrictions, e.g. RU,IR,KP
RESTRICTED_COUNTRIES=
# Optional host -> country map for ccTLD/legacy hosts (JSON). Do NOT map global-entry host here.
TENANT_HOST_COUNTRY_MAP={"beautonomi.co.za":"ZA","www.beautonomi.co.za":"ZA"}
# Global entry host and default transactional market host for unsupported-country switch prompt.
NEXT_PUBLIC_GLOBAL_ENTRY_HOST=beautonomi.com
NEXT_PUBLIC_DEFAULT_MARKET_HOST=beautonomi.co.za
# Kill-switch for automatic market routing from global entry host.
MARKET_AUTO_SWITCH_ENABLED=true
# Optional ISO2 allow-list for auto-switch rollout (empty = all allowed countries), e.g. ZA,GB,US
MARKET_AUTO_SWITCH_ALLOWED_COUNTRIES=ZA
# Optional: server 307 ZA geo redirect from global entry (default off — client banners handle UX).
MARKET_GEO_EDGE_REDIRECT_ENABLED=false
# Market manual-override cooldown before auto-switch resumes.
NEXT_PUBLIC_MARKET_OVERRIDE_TTL_HOURS=24

# ─── App URL (REQUIRED) ─────────────────────────────────────
# Local dev: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Bump when replacing global category PNGs/SVGs so browsers/CDNs fetch fresh /images/... (query: cic_rev=...).
# NEXT_PUBLIC_CATEGORY_ICON_CACHE_REVISION=20260329

# ─── Public site URL (fallback) ─────────────────────────────
# Used when Host header is missing (e.g. some build-time paths). With .com + .co.za on one Vercel project,
# canonicals, OG URLs, sitemap.xml, and JSON-LD use the *request host* at runtime.
# NEXT_PUBLIC_SITE_URL=https://beautonomi.com
# Google Search Console: submit sitemap on EACH property you verify, e.g.
#   https://beautonomi.co.za/sitemap.xml  and  https://beautonomi.com/sitemap.xml
# Edge 307 redirect: only when both are enabled (off by default; user sees top banner on .com instead).
# MARKET_GEO_EDGE_REDIRECT_ENABLED=true
# Geo redirect (Next.js src/proxy.ts): when MARKET_GEO_EDGE_REDIRECT_ENABLED=true, ZA visitors on
# NEXT_PUBLIC_GLOBAL_ENTRY_HOST may get 307 to NEXT_PUBLIC_DEFAULT_MARKET_HOST unless cookie
# beautonomi_market_geo_opt_out is set (MarketAvailabilityGate manual choice).

# ─── Paystack (REQUIRED for payments) ───────────────────────
# Get from: https://dashboard.paystack.com → Settings → API Keys & Webhooks
# Local dev: migration 403_seed_za_paystack_test_keys.sql seeds ZA region + global fallback keys
# (test mode). Env vars still override when set.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Webhook IP whitelist: https://paystack.com/docs/payments/webhooks/#ip-whitelisting
# PAYSTACK_WEBHOOK_SECRET=

# ─── Upstash Redis (recommended for distributed rate limiting) ──
# Get from: https://console.upstash.com → Redis → REST API
# When unset, rate limiting falls back to in-memory (resets on cold start).
# UPSTASH_REDIS_REST_URL=        # Required in production for distributed rate limiting (sign-in, booking, admin exports, Mapbox)
# UPSTASH_REDIS_REST_TOKEN=      # Required in production — create at https://console.upstash.com

# ─── CSRF Protection (REQUIRED in production) ────────────────
# HMAC secret for CSRF token signing. Generate: openssl rand -hex 32
# Falls back to CRON_SECRET if unset. When both are empty, CSRF rejects all mutations.
# Local: set CSRF_SECRET (or CRON_SECRET) in .env.local so authenticated POST/PATCH/DELETE from the
# browser succeed; otherwise mutations after login may fail with 403.
CSRF_SECRET=

# ─── Cron / Internal Webhooks ───────────────────────────────
# Generate a random string: openssl rand -hex 32
CRON_SECRET=
# Secondary secret accepted by /api/provider/automations/execute as fallback.
# Prefer setting CRON_SECRET instead. Generate: openssl rand -hex 32
# INTERNAL_API_SECRET=
# HMAC secret for signed “keep my account” links (6-month inactivity retention emails/push). openssl rand -hex 32
RETENTION_LINK_SECRET=
# HMAC secret for short-lived receipt/invoice PDF download tokens (native apps). openssl rand -hex 32
# If unset, minting falls back to RETENTION_LINK_SECRET (dev convenience only — set explicitly in production).
# RECEIPT_DOWNLOAD_TOKEN_SECRET=

# ─── Mapbox (optional – address autocomplete, geocode, distance) ─
# Get from: https://account.mapbox.com/access-tokens/
# Or set in Admin → Mapbox. Used for provider location address suggestions and service zones.
# MAPBOX_ACCESS_TOKEN=

# ─── Google Maps / Places (optional) ────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# GOOGLE_MAPS_API_KEY=
# GOOGLE_PLACES_API_KEY=

# ─── Sentry Error Tracking (optional) ───────────────────────
# Get from: https://sentry.io → Project Settings → Client Keys (project: web-nextjs)
# DSN for server/edge and optionally client (use NEXT_PUBLIC_SENTRY_DSN for client)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=  # Recommended; required for scale-gated rollout checks
# For source map uploads (CI/Vercel): https://sentry.io/settings/account/api/auth-tokens/
# SENTRY_AUTH_TOKEN=
# For source map uploads: org and project slugs (beautonomi / web-nextjs)
# SENTRY_ORG=beautonomi
# SENTRY_PROJECT=web-nextjs

# ─── Analytics (optional) ───────────────────────────────────
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# NEXT_PUBLIC_AMPLITUDE_API_KEY=

# ─── Mobile download banner (optional) ──────────────────────
# Store URLs for the sticky mobile app download banner. Can be direct store URLs or smart links (e.g. Branch/AppsFlyer).
# Customer app (main site): NEXT_PUBLIC_CUSTOMER_*_LINK
# Provider app (become-a-partner): NEXT_PUBLIC_PROVIDER_*_LINK
# NEXT_PUBLIC_CUSTOMER_IOS_LINK=
# NEXT_PUBLIC_CUSTOMER_ANDROID_LINK=
# NEXT_PUBLIC_CUSTOMER_HUAWEI_LINK=
# NEXT_PUBLIC_PROVIDER_IOS_LINK=
# NEXT_PUBLIC_PROVIDER_ANDROID_LINK=
# NEXT_PUBLIC_PROVIDER_HUAWEI_LINK=

# ─── OneSignal Push Notifications (REQUIRED for transactional push) ─────
# Transactional/badge/message push resolves credentials from env FIRST, then
# platform_settings (tenant_id IS NULL global row), then tenant-scoped Superadmin
# saves. If creds exist only under a tenant_id and env is empty, set these env vars
# OR save a global Platform settings row — otherwise sends fail with
# "OneSignal API keys not configured" (admin broadcast still works when it passes tenantId).
# Get from: https://app.onesignal.com → Settings → Keys & IDs
# Single-app (legacy): use ONESIGNAL_APP_ID + ONESIGNAL_REST_API_KEY for both apps
# Two-app (customer + provider): set per-app vars; fallback to legacy if unset
# ONESIGNAL_APP_ID=
# ONESIGNAL_REST_API_KEY=
# ONESIGNAL_APP_ID_CUSTOMER=
# ONESIGNAL_APP_ID_PROVIDER=
# ONESIGNAL_REST_API_KEY_CUSTOMER=
# ONESIGNAL_REST_API_KEY_PROVIDER=

# ─── Twilio (optional – SMS/WhatsApp messaging) ──────────────
# Get from: https://console.twilio.com → Account → API keys & tokens
# Used by Provider Ops SMS/WhatsApp, webhook signature verification.
# Can also be configured via Admin Settings → Integrations → Twilio (stored in platform_secrets).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=+27xxxxxxxxx
# TWILIO_WHATSAPP_FROM=+27xxxxxxxxx

# ─── Sumsub / KYC (optional) ─────────────────────────────────
# HMAC secret for Sumsub embed refresh tokens. Generate: openssl rand -hex 32
# Required in production for identity verification embed flows.
# SUMSUB_EMBED_REFRESH_SECRET=

# ─── Admin SPA routing ──────────────────────────────────────
# Default: SPA (Vite admin-web). Set to "legacy" to fall back to Next.js admin pages
# (emergency rollback only — legacy pages are scheduled for removal).
# ADMIN_SPA_ROUTING=legacy

# ─── Node Environment ───────────────────────────────────────
NODE_ENV=development

# ─── Multi-tenant CI audit (local / optional) ─────────────────
# Match CI: `pnpm audit:multi-tenant:strict` sets strict tenant hints. Temporary bypass only:
# TENANT_API_HINTS_STRICT=1
# ALLOW_TENANT_AUDIT_WARNINGS=1
