  "Describe the issue in more detail...": { "fr": "Décrivez le problème plus en détail…", "ar": "صف المشكلة بمزيد من التفصيل...", "sw": "Eleza tatizo kwa undani zaidi..." },
  "Get a personalized offer in messages": { "fr": "Recevez une offre personnalisée dans les messages", "ar": "احصل على عرض مخصص في الرسائل", "sw": "Pata ofa maalum kwenye ujumbe" },
  "Parental controls — content & safety": { "fr": "Contrôles parentaux — contenu et sécurité", "ar": "ضوابط أبوية — المحتوى والسلامة", "sw": "Vidhibiti vya wazazi — maudhui na usalama" },
  "Pay with a new card (secure browser)": { "fr": "Payer avec une nouvelle carte (navigateur sécurisé)", "ar": "الدفع ببطاقة جديدة (متصفح آمن)", "sw": "Lipa kwa kadi mpya (kivinjari salama)" },
  "Push for deals, tips, and promotions": { "fr": "Notifications pour offres, conseils et promos", "ar": "تنبيهات للعروض والنصائح والترويجات", "sw": "Arifa za ofa, vidokezo na promosheni" },
  "Share your vision and any must-haves": { "fr": "Partagez votre vision et vos indispensables", "ar": "شارك رؤيتك وأي متطلبات أساسية", "sw": "Shiriki maono yako na vitu muhimu" },
  "Verify your identity with a document": { "fr": "Vérifiez votre identité avec un document", "ar": "تحقق من هويتك بمستند", "sw": "Thibitisha utambulisho wako kwa hati" },
  "You're on {{host}} (ZAR). {{suffix}}": { "fr": "Vous êtes sur {{host}} (ZAR). {{suffix}}", "ar": "أنت على {{host}} (ZAR). {{suffix}}", "sw": "Uko kwenye {{host}} (ZAR). {{suffix}}" },
  "Attempts to reload your conversations": { "fr": "Tente de recharger vos conversations", "ar": "يحاول إعادة تحميل محادثاتك", "sw": "Inajaribu kupakia mazungumzo yako upya" },
  "Be the first to share what you think.": { "fr": "Soyez le premier à partager votre avis.", "ar": "كن أول من يشارك رأيه.", "sw": "Kuwa wa kwanza kushiriki maoni yako." },
  "Help and support. FAQs and contact us": { "fr": "Aide et assistance. FAQ et contact", "ar": "المساعدة والدعم. الأسئلة الشائعة والتواصل", "sw": "Msaada. Maswali na wasiliana nasi" },
  "Login & security → Deactivate account": { "fr": "Connexion et sécurité → Désactiver le compte", "ar": "تسجيل الدخول والأمان ← تعطيل الحساب", "sw": "Kuingia na usalama → Zima akaunti" },
  "Plan change scheduled for period end.": { "fr": "Changement d’offre prévu en fin de période.", "ar": "تغيير الخطة مجدول لنهاية الفترة.", "sw": "Mabadiliko ya mpango yamepangwa mwisho wa kipindi." },
  "See and unblock people you've blocked": { "fr": "Voir et débloquer les personnes bloquées", "ar": "عرض وإلغاء حظر من حظرتهم", "sw": "Angalia na uondoe kizuizi kwa watu uliowazuia" },
  "Under 13 — social features restricted": { "fr": "Moins de 13 ans — fonctions sociales limitées", "ar": "أقل من 13 — الميزات الاجتماعية مقيدة", "sw": "Chini ya 13 — vipengele vya kijamii vimezuiliwa" },
  "Use a different card (secure browser)": { "fr": "Utiliser une autre carte (navigateur sécurisé)", "ar": "استخدام بطاقة أخرى (متصفح آمن)", "sw": "Tumia kadi nyingine (kivinjari salama)" },
  "Where are guides and how-to articles?": { "fr": "Où sont les guides et tutoriels ?", "ar": "أين الأدلة والمقالات التعليمية؟", "sw": "Miongozo na makala zipo wapi?" },
  "You reported {{latePart}} {{ackPart}}": { "fr": "Vous avez signalé {{latePart}} {{ackPart}}", "ar": "أبلغت عن {{latePart}} {{ackPart}}", "sw": "Umeripoti {{latePart}} {{ackPart}}" },
  "Read our age suitability policy online": { "fr": "Lisez notre politique d’âge en ligne", "ar": "اقرأ سياسة الملاءمة العمرية عبر الإنترنت", "sw": "Soma sera yetu ya ufaafu wa umri mtandaoni" },
  "Tap to select a photo of your document": { "fr": "Touchez pour choisir une photo de votre document", "ar": "انقر لاختيار صورة لمستندك", "sw": "Gusa kuchagua picha ya hati yako" },
  "Uncheck to stop after a specific date.": { "fr": "Décochez pour arrêter à une date précise.", "ar": "أزل التحديد للإيقاف بعد تاريخ محدد.", "sw": "Ondoa tiki ili kuacha baada ya tarehe mahususi." },
  "View details for booking with {{name}}": { "fr": "Voir les détails de la réservation avec {{name}}", "ar": "عرض تفاصيل الحجز مع {{name}}", "sw": "Angalia maelezo ya uhifadhi na {{name}}" },
  "Your card is ready to use at checkout.": { "fr": "Votre carte est prête pour le paiement.", "ar": "بطاقتك جاهزة للاستخدام عند الدفع.", "sw": "Kadi yako iko tayari kutumika kwenye malipo." },
  "Your rating: {{score}}/5\n“{{comment}}”": { "fr": "Votre note : {{score}}/5\n« {{comment}} »", "ar": "تقييمك: {{score}}/5\n« {{comment}} »", "sw": "Ukadiriaji wako: {{score}}/5\n“{{comment}}”" },
  "{{name}}, {{count}} service, {{action}}": { "fr": "{{name}}, {{count}} service, {{action}}", "ar": "{{name}}، خدمة {{count}}، {{action}}", "sw": "{{name}}, huduma {{count}}, {{action}}" },
  "About Beautonomi. Our mission and story": { "fr": "À propos de Beautonomi. Notre mission et notre histoire", "ar": "حول Beautonomi. مهمتنا وقصتنا", "sw": "Kuhusu Beautonomi. Dhamira na hadithi yetu" },
  "Choose any amount and send it digitally": { "fr": "Choisissez un montant et envoyez-le en ligne", "ar": "اختر أي مبلغ وأرسله رقميًا", "sw": "Chagua kiasi chochote na uitume kidijitali" },
  "Enter the {{digits}}-digit code sent to": { "fr": "Saisissez le code à {{digits}} chiffres envoyé à", "ar": "أدخل الرمز المكون من {{digits}} أرقام المرسل إلى", "sw": "Weka msimbo wa tarakimu {{digits}} uliotumwa kwa" },
  "Long-press a message to reply or report": { "fr": "Appuyez longuement sur un message pour répondre ou signaler", "ar": "اضغط مطولًا على رسالة للرد أو الإبلاغ", "sw": "Bonyeza kwa muda ujumbe ili kujibu au kuripoti" },
  "Please describe what you'd like changed": { "fr": "Décrivez ce que vous souhaitez modifier", "ar": "يرجى وصف ما تريد تغييره", "sw": "Tafadhali eleza unachotaka kibadilishwe" },
  "Receive general Beautonomi SMS messages": { "fr": "Recevoir les SMS généraux Beautonomi", "ar": "تلقي رسائل SMS العامة من Beautonomi", "sw": "Pokea SMS za jumla za Beautonomi" },
  "Stay in touch with your beauty partner.": { "fr": "Restez en contact avec votre prestataire.", "ar": "ابقَ على تواصل مع شريك التجميل.", "sw": "Kaa unawasiliana na mtoa huduma wako." },
  "Tap the flag on a comment to report it.": { "fr": "Touchez le drapeau d’un commentaire pour le signaler.", "ar": "انقر على العلم في تعليق للإبلاغ عنه.", "sw": "Gusa bendera kwenye maoni ili kuripoti." },
  "WhatsApp when you receive a new message": { "fr": "WhatsApp à la réception d’un nouveau message", "ar": "واتساب عند استلام رسالة جديدة", "sw": "WhatsApp unapopokea ujumbe mpya" },
  "{{currency}} {{price}} · {{minutes}} min": { "fr": "{{currency}} {{price}} · {{minutes}} min", "ar": "{{currency}} {{price}} · {{minutes}} د", "sw": "{{currency}} {{price}} · dakika {{minutes}}" },
  "{{name}}, {{count}} options, tap to hide": { "fr": "{{name}}, {{count}} options, touchez pour masquer", "ar": "{{name}}، {{count}} خيارات، انقر للإخفاء", "sw": "{{name}}, chaguo {{count}}, gusa kuficha" },
  "{{name}}, {{count}} options, tap to show": { "fr": "{{name}}, {{count}} options, touchez pour afficher", "ar": "{{name}}، {{count}} خيارات، انقر للعرض", "sw": "{{name}}, chaguo {{count}}, gusa kuonyesha" },
  "{{name}}, {{count}} services, {{action}}": { "fr": "{{name}}, {{count}} services, {{action}}", "ar": "{{name}}، {{count}} خدمات، {{action}}", "sw": "{{name}}, huduma {{count}}, {{action}}" },
  "{{name}}, {{minutes}} minutes, {{price}}": { "fr": "{{name}}, {{minutes}} minutes, {{price}}", "ar": "{{name}}، {{minutes}} دقيقة، {{price}}", "sw": "{{name}}, dakika {{minutes}}, {{price}}" }
