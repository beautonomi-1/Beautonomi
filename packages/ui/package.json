{
  "name": "@beautonomi/ui",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./native": {
      "types": "./native-public.d.ts",
      "react-native": "./src/native/index.ts",
      "import": "./src/native/index.ts",
      "default": "./src/native/index.ts"
    },
    "./web": {
      "types": "./web-public.d.ts",
      "import": "./src/web/index.ts",
      "default": "./src/web/index.ts"
    }
  },
  "dependencies": {
    "@beautonomi/ui-tokens": "workspace:*",
    "@beautonomi/utils": "workspace:*"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18",
    "react-native": ">=0.74",
    "expo-image": ">=2"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "expo-image": {
      "optional": true
    }
  }
}
